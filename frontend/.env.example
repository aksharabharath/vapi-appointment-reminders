# Copy to .env.local (never commit .env.local).

# Neon connection string from the Neon console (or a Neon branch for local tests).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# Outbound calls (same names as today). Leave unset to browse the roster without dialing.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# Shared staff password for the console (required in Production).
STAFF_PASSWORD=
